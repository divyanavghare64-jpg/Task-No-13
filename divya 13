# Q10 #
print("\nQ10")
try:
    n=int(input("How many numbers? "))
    arr=np.random.randint(10,101,n)
    print(arr)
    print("Mean",arr.mean())
    print("Median",np.median(arr))
    print("Std",arr.std())
    print("Min",arr.min(),"Max",arr.max())
    if n%2==0:
        mat=arr.reshape(2,n//2)
        print(mat)
        print("Row sums",mat.sum(axis=1))
    else:
        print("Cannot reshape into 2D equally.")
except Exception as e:
    print("Error:",e)